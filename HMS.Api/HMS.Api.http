@baseUrl = https://localhost:7219

### Auth
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin@123"
}

### Patients
GET {{baseUrl}}/api/v1/patients?page=1&pageSize=10

###
POST {{baseUrl}}/api/v1/patients
Content-Type: application/json

{
  "firstName": "Youssef",
  "lastName": "Ali",
  "dob": "1995-04-12",
  "phone": "01234567890",
  "gender": "M",
  "email": "youssef.ali@example.com"
}

### Appointments
GET {{baseUrl}}/api/v1/appointments

###
POST {{baseUrl}}/api/v1/appointments
Content-Type: application/json

{
  "patientId": 1,
  "doctorId": 1,
  "appointmentDate": "2027-05-15T10:00:00Z",
  "reason": "Routine Checkup"
}

### Departments
GET {{baseUrl}}/api/departments

###
POST {{baseUrl}}/api/departments
Content-Type: application/json

{
  "departmentName": "Cardiology",
  "location": "Building A"
}

### Doctors
GET {{baseUrl}}/api/doctors

###
POST {{baseUrl}}/api/doctors
Content-Type: application/json

{
  "doctorId": 1,
  "specialization": "Cardiology",
  "licenseNumber": "DOC-101"
}

### Medications
GET {{baseUrl}}/api/medications

### Prescriptions
POST {{baseUrl}}/api/prescriptions
Content-Type: application/json

{
  "appointmentId": 1,
  "doctorId": 1,
  "patientId": 1,
  "datePrescribed": "2026-11-13",
  "items": [
    {
      "medicationId": 1,
      "dosage": "1 pill daily",
      "duration": "7 days"
    }
  ]
}

