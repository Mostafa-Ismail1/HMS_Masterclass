@baseUrl = https://localhost:7219

############################################################
# 1. Authentication (JWT, Roles & Refresh)
############################################################

### Login as Admin
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin@123"
}

###
@adminToken = {{loginAdmin.response.body.$.token}}
@adminRefreshToken = {{loginAdmin.response.body.$.refreshToken}}

### Refresh Access Token
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{adminRefreshToken}}"
}

### Login as Doctor
# @name loginDoctor
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "doctor",
  "password": "Doc@123"
}

###
@doctorToken = {{loginDoctor.response.body.$.token}}

############################################################
# 2. Departments API
############################################################

### GET All Departments
GET {{baseUrl}}/api/departments

### POST Create Department
POST {{baseUrl}}/api/departments
Content-Type: application/json

{
  "departmentName": "Oncology",
  "location": "Building C, 2nd Floor"
}

### DELETE Department (Unauthorized - 401)
DELETE {{baseUrl}}/api/departments/999

### DELETE Department as Doctor (Forbidden - 403)
DELETE {{baseUrl}}/api/departments/999
Authorization: Bearer {{doctorToken}}

### DELETE Department as Admin (Authorized)
DELETE {{baseUrl}}/api/departments/999
Authorization: Bearer {{adminToken}}

############################################################
# 3. Doctors API
############################################################

### GET All Doctors
GET {{baseUrl}}/api/doctors

### POST Create Doctor
POST {{baseUrl}}/api/doctors
Content-Type: application/json

{
  "firstName": "Tarek",
  "lastName": "Ibrahim",
  "email": "tarek.ibrahim@hospital.com",
  "phone": "01012345678",
  "departmentId": 1,
  "specialization": "Cardiology",
  "licenseNumber": "MED-2026-9901",
  "salary": 18000.00
}

############################################################
# 4. Patients API
############################################################

### GET Patients (Paged)
GET {{baseUrl}}/api/patients?page=1&pageSize=10

### POST Create Patient
POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "firstName": "Youssef",
  "lastName": "Ali",
  "dob": "1995-04-12",
  "phone": "01234567890",
  "gender": "M",
  "email": "youssef.ali@example.com",
  "address": "15 Nile St, Cairo",
  "bloodType": "A+"
}
